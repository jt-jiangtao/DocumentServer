FROM node:22-bookworm-slim AS node-toolchain

FROM onlyoffice/documentserver:9.4.0

ENV DEBIAN_FRONTEND=noninteractive

COPY --from=node-toolchain /usr/local/ /usr/local/

RUN apt-get update \
    && apt-get install -y --no-install-recommends git openjdk-17-jdk-headless bzip2 p7zip-full \
    && ln -s /usr/bin/python3 /usr/bin/python \
    && npm install -g grunt grunt-cli \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/onlyoffice/documentserver

COPY build_tools/ build_tools/
COPY server/ server/
COPY sdkjs/ sdkjs/
COPY web-apps/ web-apps/
COPY document-formats/ document-formats/

ARG DOCUMENTSERVER_REVISION
ARG SERVER_REVISION
ARG SDKJS_REVISION
ARG WEB_APPS_REVISION

LABEL local.onlyoffice.documentserver.revision=${DOCUMENTSERVER_REVISION} \
      local.onlyoffice.server.revision=${SERVER_REVISION} \
      local.onlyoffice.sdkjs.revision=${SDKJS_REVISION} \
      local.onlyoffice.web-apps.revision=${WEB_APPS_REVISION}

# The development builder downloads the newest core binaries regardless of the
# checked-out source revision. Keep the binaries paired with this base image.
RUN python3 - <<'PY'
from pathlib import Path

path = Path("build_tools/scripts/develop/config_server.py")
source = path.read_text(encoding="utf-8")
start = source.index('  url = base.get_autobuild_version("core",')
end = source.index("  base.generate_doctrenderer_config(", start)
source = source[:start] + '  print("Using core binaries from the base image")\n\n' + source[end:]
path.write_text(source, encoding="utf-8")
PY

RUN cp server/tools/allfontsgen server/tools/allthemesgen server/FileConverter/bin/

RUN python3 build_tools/develop/run_build_js.py /var/www/onlyoffice/documentserver --update=0 --module=server

# The example service and host browser both need to resolve the same document URL.
RUN python3 - <<'PY'
import json

path = "/etc/onlyoffice/documentserver-example/production-linux.json"
with open(path, encoding="utf-8") as source:
    config = json.load(source)
config.setdefault("server", {})["siteUrl"] = "http://127.0.0.1:8086/"
with open(path, "w", encoding="utf-8") as target:
    json.dump(config, target)

for path in (
    "/etc/onlyoffice/documentserver/nginx/ds.conf",
    "/etc/onlyoffice/documentserver/nginx/ds.conf.tmpl",
):
    with open(path, encoding="utf-8") as source:
        nginx_config = source.read()
    nginx_config = nginx_config.replace(
        "  listen 0.0.0.0:80;",
        "  listen 0.0.0.0:80;\n  listen 127.0.0.1:8086;",
        1,
    )
    with open(path, "w", encoding="utf-8") as target:
        target.write(nginx_config)
PY
